---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import LottieCourses from '../components/LottieCourses.astro';
import { SITE } from '../site';

// Service copy: Jesse's three offerings. Body text is a first draft; edit freely.
const services = [
  {
    n: '01',
    icon: '/icons/icon-consultant.svg',
    title: 'Fractional L&D Consultant',
    body: 'A senior L&D partner without the full-time hire. We map the skills that move your business, then build the programs to grow them.',
    href: '#contact',
    cta: 'Start the conversation',
  },
  {
    n: '02',
    icon: '/icons/icon-elearning.svg',
    title: 'eLearning Library',
    body: '300+ short, game-style Lottie Courses in English and Spanish. Ready today, with custom options.',
    href: '/courses',
    cta: 'Explore the library',
  },
  {
    n: '03',
    icon: '/icons/icon-workshops.svg',
    title: 'Workshops & Team Building',
    body: 'Hands-on workshops and high-energy team events, including Pilates with Pilates Daddy.',
    href: '/pilates-daddy',
    cta: 'See Pilates events',
  },
];

const topics = ['Fractional L&D Consultant', 'Lottie Courses', 'Custom eLearning', 'Platform early list', 'Workshops & Team Building', 'Pilates event', 'Something else'];
---
<Base>
  <Header />

  <main id="main">
    <section class="hero">
      <span class="spark sp1" aria-hidden="true">✦</span>
      <span class="spark sp2" aria-hidden="true">✦</span>
      <span class="spark sp3" aria-hidden="true">✦</span>
      <div class="wrap hero-inner">
        <img class="hero-script" src="/brand/script-dk.png" alt="The Strategic Learning Co." width="1000" height="160" />
        <h1>Learning with a <em>strategy</em> behind it.</h1>
        <p class="lede">
          STRATLEARN helps companies build teams that grow: fractional L&amp;D consulting,
          ready-to-launch eLearning, and workshops people actually enjoy.
        </p>
        <div class="hero-ctas">
          <a href="#contact" class="btn btn-primary">Let's talk</a>
          <a href="#services" class="btn btn-ghost">Our services</a>
        </div>
      </div>
    </section>

    <section id="services" class="section soft">
      <div class="wrap">
        <span class="eyebrow">Services</span>
        <h2 class="section-title">Three ways we help your people grow.</h2>
        <div class="cards">
          {services.map((s) => (
            <article class="card">
              <div class="card-top"><img class="card-icon" src={s.icon} alt="" width="500" height="500" loading="lazy" /><span class="card-n">{s.n}</span></div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <a class="card-link" href={s.href}>{s.cta} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <LottieCourses variant="home" />

    <section class="section pd-teaser">
      <div class="wrap pd-grid">
        <img src="/pilates-daddy/shirt.jpg" alt="Pilates Daddy logo on Jesse's shirt, framed by a Pilates ring" width="1400" height="803" class="pd-logo" loading="lazy" />
        <div>
          <span class="eyebrow">Workshops &amp; Events</span>
          <h2>Team building, with a little more core.</h2>
          <p>
            Pilates Daddy brings high-energy Pilates sessions to your offsite, wellness day or team event. Every level
            welcome, good music guaranteed.
          </p>
          <a href="/pilates-daddy" class="btn btn-ghost">Meet Pilates Daddy</a>
        </div>
      </div>
    </section>

    <section id="about" class="section soft">
      <div class="wrap split">
        <div>
          <span class="eyebrow">About</span>
          <h2>Meet Jesse Stråt.</h2>
          <img class="headshot" src="/photos/jesse-headshot-square.jpg" alt="Jesse Stråt, founder of STRATLEARN" width="700" height="700" loading="lazy" />
        </div>
        <div class="split-body">
          <p>
            Jesse Stråt is an award-winning Learning &amp; Development executive. Jesse won Gold at the Stevie Awards
            as Learning or Training Professional of the Year (2024), has been named an OnCon Icon Top 100 L&amp;D
            Professional three years running (2024, 2025 and 2026), and is a San Diego Business Journal 40 Under 40
            honoree for 2026.
          </p>
          <p>
            Jesse is driven to create learning people actually want to take. That means humor, real stories and
            sticky training, so what your team learns doesn't go in one ear and out the other.
          </p>
          <p>
            Outside the boardroom, Jesse teaches Pilates and Sculpt classes in San Diego as <a href="/pilates-daddy">Pilates Daddy</a>.
          </p>
          <ul class="badges" aria-label="Recognition">
            <li>Stevie Award, Gold · 2024</li>
            <li>OnCon Icon Top 100 · 2024–2026</li>
            <li>SDBJ 40 Under 40 · 2026</li>
            <li>San Diego, CA</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="contact" class="section contact">
      <div class="wrap contact-grid">
        <div class="contact-copy">
          <span class="eyebrow light">Get in touch</span>
          <h2>Let's build something your team will use.</h2>
          <p>Tell us a little about your goals and we'll reply within one business day.</p>
          <p>Prefer email? <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          {SITE.calLink && (
            <button type="button" class="btn btn-light" data-cal-link={SITE.calLink} data-cal-config='{"layout":"month_view"}'>
              Book a discovery call
            </button>
          )}
        </div>
        <ContactForm topics={topics} />
      </div>
    </section>
  </main>

  <Footer />

  {SITE.calLink && (
    <script is:inline>
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", { origin: "https://cal.com" });
    </script>
  )}
</Base>

<style>
  .hero { position: relative; overflow: hidden; text-align: center; padding: clamp(4rem, 9vw, 7.5rem) 0 clamp(3rem, 6vw, 4.5rem); background:
    radial-gradient(50rem 26rem at 50% -10%, rgba(197,168,245,.5), transparent 65%),
    radial-gradient(30rem 20rem at 0% 100%, rgba(107,57,177,.08), transparent 60%),
    radial-gradient(30rem 20rem at 100% 100%, rgba(107,57,177,.08), transparent 60%); }
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  .hero-script { width: min(340px, 78%); height: auto; margin-bottom: 1.6rem; }
  .hero h1 { max-width: 14ch; }
  .hero h1 em { font-style: italic; color: var(--violet); }
  .lede { font-size: 1.25rem; color: var(--muted); max-width: 36rem; margin: 1.6rem auto 2.2rem; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  .spark { position: absolute; color: var(--lilac); pointer-events: none; }
  .sp1 { top: 18%; left: 12%; font-size: 2rem; }
  .sp2 { top: 34%; right: 11%; font-size: 2.6rem; color: #d9c6fa; }
  .sp3 { top: 58%; left: 20%; font-size: 1.1rem; }
  @media (max-width: 760px) {
        .sp2 { top: 3%; right: 8%; font-size: 1.8rem; } .sp1 { top: 4%; left: 8%; font-size: 1.3rem; } .sp3 { display: none; }
  }

  .section { padding: clamp(4rem, 9vw, 7rem) 0; }
  .section.soft { background: var(--mist); }
  .section-title { max-width: 40rem; margin-bottom: 3rem; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 2rem 1.6rem; display: flex; flex-direction: column; transition: border-color .2s, transform .2s; }
  .card:hover { border-color: var(--lilac); transform: translateY(-3px); }
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; }
  .card-icon { width: 76px; height: 76px; }
  .card-n { font-family: var(--caps); font-weight: 700; color: var(--lilac); letter-spacing: .1em; font-size: .9rem; }
  .card h3 { margin: 1rem 0 .7rem; }
  .card p { color: var(--muted); font-size: .98rem; margin: 0 0 1.4rem; flex: 1; }
  .card-link { font-family: var(--caps); font-weight: 600; text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; color: var(--violet); text-decoration: none; }
  .card-link:hover { color: var(--plum); }

  .split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem; align-items: start; }
  #about .split-body { padding-top: 3.2rem; }
  @media (max-width: 960px) { #about .split-body { padding-top: 0; } }
  .split-body { font-size: 1.15rem; color: var(--muted); }
  .ticks { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: .6rem; }
  .ticks li { padding-left: 1.8rem; position: relative; color: var(--ink); }
  .ticks li::before { content: '✦'; position: absolute; left: 0; color: var(--violet); }

  .headshot { margin-top: 2rem; border-radius: 20px; aspect-ratio: 1 / 1; object-fit: cover; width: 100%; max-width: 360px; box-shadow: 0 30px 60px -30px rgba(64,2,101,.45); }
  .badges { list-style: none; padding: 0; margin: 1.6rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .badges li { font-family: var(--caps); font-weight: 600; text-transform: uppercase; letter-spacing: .12em; font-size: .72rem; color: var(--plum); background: #fff; border: 1px solid var(--lilac); padding: .55rem .9rem .45rem; border-radius: 999px; }
  .pd-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: center; }
  .pd-logo { width: 100%; border-radius: 22px; box-shadow: 0 30px 60px -30px rgba(64,2,101,.5); }
  .pd-teaser p { color: var(--muted); font-size: 1.15rem; margin: 1.2rem 0 2rem; }

  .contact { background: linear-gradient(135deg, var(--plum), #2a0143 70%); color: #efe7ff; }
  .contact h2 { color: #fff; margin-bottom: 1.2rem; }
  .contact a { color: var(--lilac); }
  .eyebrow.light { color: var(--lilac); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: start; }
  .contact-copy .btn { margin-top: 1rem; }

  @media (max-width: 960px) {
    .split, .contact-grid, .pd-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .cards { grid-template-columns: 1fr; max-width: 560px; }
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
