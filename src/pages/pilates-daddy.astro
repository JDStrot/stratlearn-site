---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../site';

// First-draft copy for Pilates Daddy. Edit freely.
const offers = [
  {
    icon: '/pilates-daddy/icon-ball.png',
    title: 'Team Pilates events',
    body: 'A high-energy group class for your office, offsite or team event. Mat-based, every level welcome, and set to a soundtrack people talk about after.',
  },
  {
    icon: '/pilates-daddy/icon-circle.png',
    title: 'Wellness days',
    body: 'Pair Pilates with a STRATLEARN workshop for a day that works the mind and the core. Great for kickoffs and team resets.',
  },
  {
    icon: '/pilates-daddy/icon-dumbbells.png',
    title: 'Private & small group',
    body: 'Personal sessions for individuals, friends or small teams, built around your goals, from core strength to full-body conditioning.',
  },
];

const topics = ['Pilates event', 'Wellness day', 'Private or small group session', 'Something else'];
---
<Base
  title="Pilates Daddy"
  description="Pilates Daddy (Jesse Stråt) brings high-energy Pilates to team events, wellness days and private sessions. A STRATLEARN brand."
  image="/pilates-daddy/og.jpg"
>
  <Header cta="#book" />

  <main id="main" class="pd">
    <section class="pd-hero">
      <span class="sparkle s1" aria-hidden="true">✦</span>
      <span class="sparkle s2" aria-hidden="true">✦</span>
      <span class="sparkle s3" aria-hidden="true">✦</span>
      <div class="wrap pd-hero-inner">
        <h1 class="sr-only">Pilates Daddy</h1>
        <img src="/pilates-daddy/logo-rev.png" alt="Pilates Daddy" width="1000" height="623" class="pd-hero-logo" />
        <p class="pd-lede">Strong cores. Big energy. Pilates for teams, events and anyone ready to feel it tomorrow.</p>
        <div class="pd-ctas">
          <a href="#book" class="btn btn-light">Book a session</a>
          <a href={SITE.pilatesInstagram} class="btn btn-outline-light" target="_blank" rel="noopener">@yourpilatesdaddy</a>
        </div>
      </div>
    </section>

    <section id="offers" class="section">
      <div class="wrap">
        <span class="eyebrow">What we offer</span>
        <h2 class="section-title">Pilates that brings people together.</h2>
        <div class="offers">
          {offers.map((o) => (
            <article class="offer">
              <img src={o.icon} alt="" width="500" height="500" loading="lazy" />
              <div>
                <h3>{o.title}</h3>
                <p>{o.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="mission" class="section mvv-section" aria-labelledby="mvv-title">
      <div class="wrap">
        <span class="eyebrow">What drives Pilates Daddy</span>
        <h2 id="mvv-title" class="sr-only">Mission, vision and values</h2>
        <div class="mvv">
          <article class="mvv-card light">
            <img src="/pilates-daddy/icon-ball.png" alt="" width="500" height="500" loading="lazy" />
            <h3 class="mvv-label">Mission</h3>
            <p>To make you <em>laugh</em>, move you <em>deeply</em>, and <b>rebuild</b> you <b>stronger</b> through the power of <b>Pilates</b>.</p>
          </article>
          <article class="mvv-card dark">
            <img src="/pilates-daddy/icon-circle.png" alt="" width="500" height="500" loading="lazy" />
            <h3 class="mvv-label">Vision</h3>
            <p>To <em>empower</em> every <b>Pilates</b> student to take <em>center stage</em>–in the <b>studio</b> and in <em>life</em>.</p>
          </article>
          <article class="mvv-card light">
            <img src="/pilates-daddy/icon-dumbbells.png" alt="" width="500" height="500" loading="lazy" />
            <h3 class="mvv-label">Values</h3>
            <p class="values">Humor.<br />Storytelling.<br /><em>Unapologetic</em> Confidence.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section soft media">
      <div class="wrap media-grid">
        <div class="video-wrap">
          <video src="/pilates-daddy/pilates-daddy.mp4" poster="/pilates-daddy/video-poster.jpg" playsinline controls preload="none" aria-label="Pilates Daddy class highlights"></video>
        </div>
        <div>
          <span class="eyebrow">See it in action</span>
          <h2>Modern movement, <em>maximum</em> fun.</h2>
          <p class="media-copy">From rooftops to studios, every class is built to move you, challenge you and leave you smiling. Follow along for class drops, events and behind-the-scenes.</p>
          <img class="rooftop" src="/pilates-daddy/rooftop-class.jpg" alt="Jesse leading a rooftop Pilates class in downtown San Diego" width="1200" height="1500" loading="lazy" />
          <a href={SITE.pilatesInstagram} class="btn btn-primary ig" target="_blank" rel="noopener">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
            Follow @yourpilatesdaddy
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap why">
        <img class="ring" src="/pilates-daddy/jesse-ring.jpg" alt="Jesse Stråt, Pilates Daddy, holding a Pilates ring" width="1400" height="934" loading="lazy" />
        <div>
          <span class="eyebrow">Meet Pilates Daddy</span>
          <h2>Serious technique. <em>Zero</em> boring.</h2>
          <p class="bio">
            Pilates Daddy is Jesse Stråt, a group fitness instructor teaching Pilates and Sculpt classes in
            San Diego, CA. Jesse is also an award-winning Learning &amp; Development executive, so every class is
            built to be fun, clear and something you'll remember.
          </p>
          <ul class="ticks">
            <li>Pilates and Sculpt classes, taught in San Diego</li>
            <li>Every level welcome, with modifications for most exercises</li>
            <li>Custom mixes that keep the room moving</li>
            <li>Mat-based, so we can set up almost anywhere</li>
            <li>Pairs with STRATLEARN workshops for a full team day</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="book" class="section contact">
      <div class="wrap contact-grid">
        <div>
          <span class="eyebrow light">Book Pilates Daddy</span>
          <h2>Bring the energy to your next event.</h2>
          <div class="price">
            <div class="price-amount">$150 <span>per event</span></div>
            <ul>
              <li>Includes your instructor, the class and the music</li>
              <li>I come to you, anywhere in San Diego</li>
              <li>Guests bring their own mats and props</li>
            </ul>
            <div class="price-extra">
              <strong>Extra, priced on request</strong>
              <span>Mats, props or studio space. Tick what you need in the form and I'll send a quote.</span>
            </div>
          </div>
          <p>Share your date, group size and location, and I'll reply within one business day.</p>
          <p>Prefer email? <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
        <ContactForm formName="pilates-booking" topics={topics} needs={['Mats (extra)', 'Studio space (extra)', 'Props (extra)']} messageLabel="Event details" messagePlaceholder="Date, time, group size and location" />
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .pd-hero { position: relative; overflow: hidden; background: radial-gradient(50rem 30rem at 50% 0%, #6b39b1 0%, var(--plum) 60%); color: #fff; padding: clamp(4rem, 9vw, 7rem) 0 clamp(4rem, 8vw, 6rem); text-align: center; }
  .pd-hero-inner { display: flex; flex-direction: column; align-items: center; }
  .pd-hero-logo { width: min(560px, 90%); }
  .pd-lede { font-size: 1.3rem; max-width: 34rem; margin: 2rem 0 2.2rem; color: #efe7ff; }
  .pd-ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  .btn-outline-light { border-color: var(--lilac); color: #fff; }
  .btn-outline-light:hover { background: var(--lilac); color: var(--plum); }
  .sparkle { position: absolute; color: var(--lilac); opacity: .5; animation: twinkle 3.2s ease-in-out infinite; }
  .s1 { top: 14%; left: 9%; font-size: 2.6rem; }
  .s2 { top: 62%; right: 8%; font-size: 2rem; animation-delay: 1s; }
  .s3 { bottom: 12%; left: 18%; font-size: 1.3rem; animation-delay: 2s; }
  @keyframes twinkle { 50% { opacity: 1; transform: scale(1.2) rotate(15deg); } }
  @media (prefers-reduced-motion: reduce) { .sparkle { animation: none; } }

  .section { padding: clamp(4rem, 9vw, 7rem) 0; }
  .section.soft { background: var(--mist); }
  .section-title { max-width: 40rem; margin-bottom: 3rem; }

  .offers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .offer { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 1.3rem 1.4rem; display: grid; grid-template-columns: 64px 1fr; column-gap: 1rem; align-items: start; transition: transform .2s, border-color .2s; }
  .offer:hover { transform: translateY(-3px); border-color: var(--lilac); }
  .offer img { width: 64px; height: 64px; object-fit: contain; }
  .offer h3 { font-size: 1.4rem; margin: .2rem 0 .4rem; }
  .offer p { color: var(--muted); margin: 0; font-size: .97rem; }

  .why { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 4rem; align-items: center; }
  .bio { color: var(--muted); font-size: 1.1rem; margin-top: 1.4rem; }
  .why h2 em { font-style: italic; color: var(--violet); }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; font-size: 1.15rem; }
  .ticks li { padding-left: 1.9rem; position: relative; }
  .ticks li::before { content: '✦'; position: absolute; left: 0; color: var(--violet); }

  .media-grid { display: grid; grid-template-columns: minmax(0, 380px) 1fr; gap: 4rem; align-items: center; justify-content: center; }
  .video-wrap { border-radius: 24px; overflow: hidden; box-shadow: 0 40px 80px -40px rgba(64,2,101,.6); background: var(--plum); aspect-ratio: 536 / 954; }
  .video-wrap video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .media h2 em { font-style: italic; color: var(--violet); }
  .media-copy { color: var(--muted); font-size: 1.15rem; margin: 1.2rem 0 1.6rem; max-width: 34rem; }
  .rooftop { width: 100%; max-width: 520px; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 8%; border-radius: 18px; margin-bottom: 1.8rem; }
  .ig { gap: .6rem; }
  .ring { width: 100%; border-radius: 22px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 48% 50%; box-shadow: 0 30px 60px -30px rgba(64,2,101,.45); }
  .ticks { margin-top: 1.6rem; }
  .contact { background: linear-gradient(135deg, var(--plum), #2a0143 70%); color: #efe7ff; }
  .contact h2 { color: #fff; margin-bottom: 1.2rem; }
  .contact a { color: var(--lilac); }
  .eyebrow.light { color: var(--lilac); }
  .price { background: rgba(255,255,255,.07); border: 1px solid rgba(197,168,245,.35); border-radius: 18px; padding: 1.6rem 1.8rem; margin: .4rem 0 1.6rem; }
  .price-amount { font-family: var(--serif); font-size: 3.4rem; line-height: 1; color: #fff; }
  .price-amount span { font-family: var(--caps); font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; color: var(--lilac); margin-left: .4rem; }
  .price ul { list-style: none; padding: 0; margin: 1.1rem 0 0; display: grid; gap: .5rem; }
  .price li { padding-left: 1.6rem; position: relative; }
  .price-extra { margin-top: 1.2rem; padding-top: 1.1rem; border-top: 1px dashed rgba(197,168,245,.45); display: grid; gap: .3rem; }
  .price-extra strong { font-family: var(--caps); font-weight: 600; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--lilac); }
  .price-extra span { color: #efe7ff; }
  .price li::before { content: '✦'; position: absolute; left: 0; color: var(--lilac); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: start; }

  .mvv-section { padding-top: 0; }
  .mvv-section .eyebrow { display: block; margin-bottom: 1.25rem; }
  .mvv { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .mvv-card { position: relative; border-radius: 18px; padding: 1.2rem 1.6rem 1.7rem; overflow: hidden; }
  .mvv-card.light { background: linear-gradient(160deg, var(--mist) 0%, #d9c6fb 100%); }
  .mvv-card.dark { background: radial-gradient(28rem 18rem at 100% 0%, #5a1f8a 0%, var(--plum) 60%); color: #fff; }
  .mvv-card img { position: absolute; top: 1.2rem; right: 1.2rem; width: 56px; height: 56px; object-fit: contain; }
  .mvv-label { font-family: var(--caps); font-weight: 600; text-transform: uppercase; letter-spacing: .18em; font-size: .78rem; color: var(--plum); margin: 0 0 .9rem; min-height: 56px; display: flex; align-items: center; padding-right: 64px; }
  .mvv-card.dark .mvv-label { color: var(--lilac); }
  .mvv-card p { font-family: var(--serif); font-size: clamp(1.5rem, 2.1vw, 1.85rem); line-height: 1.15; margin: 0; max-width: 15em; color: #fff; }
  .mvv-card.light p { color: var(--plum); }
  .mvv-card.light p em { color: var(--violet); }
  .mvv-card p b { font-family: var(--sans); font-weight: 500; font-size: .86em; letter-spacing: -.01em; }
  @media (max-width: 720px) {
  }
  @media (max-width: 960px) {
    .offers, .mvv { grid-template-columns: 1fr; gap: .9rem; }
    .why, .contact-grid, .media-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .video-wrap, .ring { max-width: 380px; margin: 0 auto; width: 100%; }
  }
</style>
