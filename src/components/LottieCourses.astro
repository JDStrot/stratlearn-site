---
// Lottie Courses section. variant "home" = overview on the homepage, "full" = the /courses page.
import { lottieIntro, proof, features, lottie, meetLottie, pricing, freePreview, previewShots, courses, packs, platform, closing } from '../lottie';
interface Props { variant?: 'home' | 'full' }
const { variant = 'home' } = Astro.props;
const full = variant === 'full';
const packsHref = full ? '#packs' : '/courses#packs';
const HeadingTag = full ? 'h1' : 'h2';
---
<div class="lottie">
  <!-- 1. Headline block -->
  <section id="lottie-courses" class="lc-intro">
    <div class="wrap lc-intro-grid">
      <div class="lc-intro-copy">
        <span class="eyebrow">{lottieIntro.eyebrow}</span>
        <HeadingTag class="lc-h">{lottieIntro.headline}</HeadingTag>
        <p class="lc-sub">{lottieIntro.subhead}</p>
        <div class="lc-ctas">
          <a href="/preview" class="btn btn-primary">Try a free course</a>
          <a href={packsHref} class="btn btn-ghost">See the industry packs</a>
        </div>
      </div>
      <div class="lc-intro-media">
        <figure class="device phone">
          <img src={lottieIntro.image.src} alt={lottieIntro.image.alt} width="520" height="1125" />
        </figure>
      </div>
    </div>

    <!-- 2. Proof strip -->
    <div class="wrap">
      <ul class="proof" aria-label="Lottie Courses at a glance">
        {proof.map((p) => (
          <li><strong>{p.big}</strong><span>{p.small}</span></li>
        ))}
      </ul>
    </div>
  </section>

  {full && (
  <section class="section soft lc-why">
    <div class="wrap">
      <span class="eyebrow">Why it works</span>
      <h2 class="lc-section-title">Built so people finish, and remember.</h2>
      <div class="features">
        {features.map((f) => (
          <article class="feature">
            <div class={`feature-media is-${f.kind}`}>
              {f.kind === 'phone' ? (
                <figure class="device phone small"><img src={f.image.src} alt={f.image.alt} width="520" height="1125" loading="lazy" /></figure>
              ) : (
                <img class="character" src={f.image.src} alt={f.image.alt} width="440" height="376" loading="lazy" />
              )}
            </div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  )}

  {full && (
    <section class="section lc-meet">
      <div class="wrap meet">
        <img class="meet-img" src={lottie.src} alt={lottie.alt} width="440" height="393" loading="lazy" />
        <div>
          <span class="eyebrow">{meetLottie.eyebrow}</span>
          <h2>{meetLottie.headline}</h2>
          {meetLottie.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  )}

  {full && (
  <section id="free-course" class={`section lc-preview ${full ? 'soft' : ''}`}>
    <div class="wrap">
      <div class="preview-head">
        <div>
          <span class="eyebrow">Free preview</span>
          <h2>{freePreview.headline}</h2>
        </div>
        <div>
          <p>{freePreview.body}</p>
          <a href="/preview" class="btn btn-primary">Start the free course</a>
        </div>
      </div>
      <a href="/preview" class="preview-phones" aria-label="Start the free course: Find Your Leadership Style">
        {previewShots.map((img) => (
          <figure class="device phone small"><img src={img.src} alt={img.alt} width="520" height="1125" loading="lazy" /></figure>
        ))}
      </a>
    </div>
  </section>
  )}

  <!-- Featured courses (six highlights) -->
  <section class={`section lc-cards ${full ? '' : 'soft'}`}>
    <div class="wrap">
      <div class="cards-head">
        <div>
          <span class="eyebrow">Featured courses</span>
          <h2>A taste of the library.</h2>
        </div>
        <p class="cards-hint lc-phone-only" aria-hidden="true">Swipe →</p>
      </div>
    </div>
    <ul class="course-row" aria-label="Featured courses">
      {courses.map((c) => (
        <li class="course-card">
          <div class="course-art">
            <img src={c.image.src} alt={c.image.alt} width="800" height="410" loading="lazy" />
            {c.free && <span class="free-tag">Free preview</span>}
          </div>
          <div class="course-body">
            <span class="course-meta">{c.category} · {c.time}</span>
            <h3>{c.title}</h3>
            <p>{c.synopsis}</p>
            {c.free && <a class="card-link" href="/preview">Play it free <span aria-hidden="true">→</span></a>}
          </div>
        </li>
      ))}
    </ul>
    {!full && (
      <div class="wrap lc-more">
        <a href="/courses" class="btn btn-ghost">Explore Lottie Courses</a>
      </div>
    )}
  </section>

  {full && (
    <section id="packs" class="section soft lc-packs">
      <div class="wrap split">
        <div>
          <span class="eyebrow">Industry packs</span>
          <h2>{packs.headline}</h2>
        </div>
        <div>
          <p class="split-p">{packs.body}</p>
          <ul class="chips">{packs.chips.map((c) => <li>{c}</li>)}</ul>
          <a href="/courses?topic=Lottie%20Courses#contact" class="btn btn-primary">See all 25 packs</a>
        </div>
      </div>
    </section>
  )}

  {full && (
    <section class="section lc-platform">
      <div class="wrap split">
        <div>
          <span class="soon">Coming soon</span>
          <h2>{platform.headline}</h2>
          <p class="split-p light">{platform.body}</p>
        </div>
        <div>
          <ul class="platform-list">{platform.items.map((i) => <li>{i}</li>)}</ul>
          <a href="/courses?topic=Platform%20early%20list#contact" class="btn btn-light">Join the early list</a>
        </div>
      </div>
    </section>
  )}

  {full && (
    <section id="pricing" class="section lc-pricing">
      <div class="wrap">
        <div class="pricing-head">
          <span class="eyebrow">{pricing.eyebrow}</span>
          <h2>{pricing.headline}</h2>
          <p>{pricing.sub}</p>
        </div>
        <div class="founding">
          <div>
            <span class="soon">{pricing.founding.label}</span>
            <p>{pricing.founding.text}</p>
          </div>
          <a href={`/courses?topic=${encodeURIComponent(pricing.founding.topic)}#contact`} class="btn btn-light">{pricing.founding.cta}</a>
        </div>
        <div class="plans">
          {pricing.plans.map((p) => (
            <article class={`plan ${p.featured ? 'featured' : ''}`}>
              {p.featured && <span class="plan-flag">Most popular</span>}
              <h3>{p.name}</h3>
              <div class="plan-price"><strong>{p.price}</strong><span>{p.unit}</span></div>
              <p class="plan-note">{p.note}</p>
              <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
              <a href={`/courses?topic=${encodeURIComponent(p.topic)}#contact`} class={`btn ${p.featured ? 'btn-primary' : 'btn-ghost'}`}>{p.cta}</a>
            </article>
          ))}
        </div>
        <ul class="extras">
          {pricing.extras.map((e) => <li>{e}</li>)}
        </ul>
        <a href="/preview" class="extras-link">Try the free course first <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  {full && (
    <section class="section soft lc-closing">
      <div class="wrap closing">
        <img src="/lottie/lottie-golden-pearl.png" alt="" width="440" height="376" loading="lazy" />
        <h2>{closing.headline}</h2>
        <a href="/preview" class="btn btn-primary">Try a free course</a>
      </div>
    </section>
  )}
</div>

<style>
  .section { padding: clamp(4rem, 9vw, 7rem) 0; }
  .soft { background: var(--mist); }
  .lc-h { font-size: clamp(2.5rem, 6vw, 4.4rem); }
  .lc-intro { padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 4.5rem);
    background: radial-gradient(50rem 28rem at 100% 0%, rgba(197,168,245,.4), transparent 60%); }
  .lc-intro-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  .lc-sub { font-size: 1.2rem; color: var(--muted); margin: 1.3rem 0 2rem; max-width: 36rem; }
  .lc-ctas { display: flex; flex-wrap: wrap; gap: .8rem; }
  .lc-intro-media { display: flex; justify-content: center; }
  .lc-section-title { margin-bottom: 2.5rem; max-width: 40rem; }

  /* Device frames */
  .device { margin: 0; }
  .device img { display: block; width: 100%; height: auto; }
  .phone { width: min(260px, 70vw); padding: 10px; border-radius: 42px; background: #1b0a2b; box-shadow: 0 40px 70px -35px rgba(64,2,101,.6), inset 0 0 0 2px #3a2255; position: relative; }
  .phone img { border-radius: 32px; }
  .phone::before { content: ''; position: absolute; top: 18px; left: 50%; transform: translateX(-50%); width: 70px; height: 18px; border-radius: 10px; background: #1b0a2b; z-index: 1; }
  .phone.small { width: 200px; padding: 8px; border-radius: 34px; }
  .phone.small img { border-radius: 26px; }
  .phone.small::before { top: 14px; width: 54px; height: 14px; }

  /* Proof strip */
  .proof { list-style: none; margin: 3rem 0 0; padding: 1.6rem 1.4rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem 1rem; background: var(--plum); border-radius: 20px; color: #efe7ff; }
  .proof li { display: grid; gap: .2rem; }
  .proof strong { font-family: var(--serif); font-weight: 400; font-size: 2.4rem; line-height: 1; color: #fff; }
  .proof span { font-size: .9rem; color: var(--lilac); }

  /* Features */
  .features { display: grid; grid-auto-flow: column; grid-auto-columns: 80%; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .8rem; margin: 0 -16px; padding-left: 16px; padding-right: 16px; scroll-padding: 16px; }
  .feature { scroll-snap-align: start; }
  .feature { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 1.6rem; display: grid; gap: .6rem; align-content: start; }
  .feature-media { display: flex; justify-content: center; align-items: flex-end; height: 260px; overflow: hidden; margin: -1.6rem -1.6rem .6rem; padding-top: 1.6rem; background: linear-gradient(180deg, var(--mist), #fff); border-radius: 20px 20px 0 0; }
  .feature-media .phone { align-self: flex-start; }
  .feature-media.is-character { align-items: center; padding: 1.2rem; }
  .character { width: auto; max-height: 200px; }
  .feature h3 { font-size: 1.5rem; }
  .feature p { color: var(--muted); margin: 0; }


  /* Free preview */
  .preview-head { display: grid; gap: 1.2rem; margin-bottom: 2rem; }
  .preview-head p { color: var(--muted); font-size: 1.1rem; margin-bottom: 1.4rem; }
  .preview-phones { display: flex; justify-content: center; gap: clamp(.8rem, 3vw, 2.5rem); text-decoration: none; }
  .preview-phones .phone.small { width: min(200px, 42vw); transition: transform .2s; }
  .preview-phones .phone.small:nth-child(2) { transform: translateY(2rem); }
  .preview-phones:hover .phone.small:first-child { transform: translateY(-4px); }
  .lc-preview { padding-bottom: clamp(6rem, 11vw, 9rem); }

  /* Course cards: swipe row on phones, grid on desktop */
  .cards-head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 1.8rem; }
  .cards-hint { margin: 0; font-family: var(--caps); font-weight: 600; font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--violet); }
  .course-row { list-style: none; margin: 0; padding: 0 16px 1rem; display: grid; grid-auto-flow: column; grid-auto-columns: 82%; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 16px; -webkit-overflow-scrolling: touch; }
  .course-card { scroll-snap-align: start; background: #fff; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; display: flex; flex-direction: column; }
  .course-art { position: relative; }
  .course-art img { width: 100%; aspect-ratio: 800 / 410; object-fit: cover; }
  .free-tag { position: absolute; top: 12px; left: 12px; background: var(--plum); color: #fff; font-family: var(--caps); font-weight: 600; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; padding: .45rem .7rem .35rem; border-radius: 999px; }
  .course-body { padding: 1.3rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: .4rem; flex: 1; }
  .course-meta { font-family: var(--caps); font-weight: 600; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--violet); }
  .course-body h3 { font-size: 1.45rem; }
  .course-body p { color: var(--muted); font-size: .96rem; margin: 0; flex: 1; }
  .card-link { margin-top: .8rem; font-family: var(--caps); font-weight: 600; text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; color: var(--violet); text-decoration: none; }
  .lc-more { margin-top: 2rem; }

  /* Packs */
  .split { display: grid; gap: 1.5rem; }
  .split-p { color: var(--muted); font-size: 1.15rem; }
  .chips { list-style: none; padding: 0; margin: 1.2rem 0 2rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .chips li { background: #fff; color: var(--plum); border-radius: 999px; padding: .5rem .9rem; font-size: .92rem; font-weight: 500; }

  /* Platform (coming soon) */
  .lc-platform { background: linear-gradient(135deg, var(--plum), #2a0143 70%); color: #efe7ff; }
  .lc-platform h2 { color: #fff; margin-top: .9rem; }
  .split-p.light { color: #d9cdf0; margin-top: 1rem; }
  .soon { display: inline-block; background: var(--lilac); color: var(--plum); font-family: var(--caps); font-weight: 700; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; padding: .5rem .85rem .4rem; border-radius: 999px; }
  .platform-list { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: .8rem; font-size: 1.08rem; }
  .platform-list li { padding-left: 1.8rem; position: relative; }
  .platform-list li::before { content: '✦'; position: absolute; left: 0; color: var(--lilac); }

  /* Pricing */
  .pricing-head { max-width: 44rem; margin-bottom: 2rem; }
  .pricing-head p { color: var(--muted); font-size: 1.1rem; margin-top: 1rem; }
  .founding { display: grid; gap: 1rem; align-items: center; background: var(--plum); color: #efe7ff; border-radius: 20px; padding: 1.4rem 1.6rem; margin-bottom: 1.5rem; }
  .founding p { margin: .7rem 0 0; font-size: 1.1rem; color: #fff; }
  .founding .btn { justify-self: start; }
  .plans { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .plan { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 1.6rem 1.5rem; display: flex; flex-direction: column; }
  .plan.featured { border: 2px solid var(--violet); box-shadow: 0 30px 60px -35px rgba(64,2,101,.45); }
  .plan-flag { position: absolute; top: -12px; left: 1.5rem; background: var(--violet); color: #fff; font-family: var(--caps); font-weight: 600; font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; padding: .4rem .7rem .3rem; border-radius: 999px; }
  .plan h3 { font-size: 1.6rem; }
  .plan-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: .4rem; margin-top: .6rem; }
  .plan-price strong { font-family: var(--serif); font-weight: 400; font-size: 2.6rem; line-height: 1; color: var(--plum); }
  .plan-price span { color: var(--muted); font-size: .9rem; }
  .plan-note { font-family: var(--caps); font-weight: 600; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--violet); margin: .7rem 0 1rem; }
  .plan ul { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: .55rem; flex: 1; align-content: start; }
  .plan li { padding-left: 1.5rem; position: relative; font-size: .96rem; }
  .plan li::before { content: '✦'; position: absolute; left: 0; color: var(--violet); font-size: .85rem; top: .1rem; }
  .plan .btn { justify-content: center; }
  .extras { list-style: none; padding: 0; margin: 1.8rem 0 1rem; display: grid; gap: .5rem; color: var(--muted); font-size: .95rem; }
  .extras li { padding-left: 1.5rem; position: relative; }
  .extras li::before { content: '+'; position: absolute; left: 0; color: var(--violet); font-weight: 700; }
  .extras-link { font-family: var(--caps); font-weight: 600; text-transform: uppercase; letter-spacing: .12em; font-size: .78rem; color: var(--violet); text-decoration: none; }

  /* Closing */
  .closing { text-align: center; display: grid; justify-items: center; gap: 1.4rem; }
  .closing img { width: 160px; }
  .meet { display: grid; gap: 2rem; align-items: center; }
  .meet-img { width: min(300px, 70vw); justify-self: center; }
  .meet h2 { margin-bottom: 1.2rem; }
  .meet p { color: var(--muted); font-size: 1.15rem; max-width: 36rem; }
  @media (min-width: 961px) { .meet { grid-template-columns: 0.8fr 1.2fr; gap: 4rem; } }


  @media (min-width: 720px) {
    .plans { grid-template-columns: repeat(2, 1fr); }
    .founding { grid-template-columns: 1fr auto; }
    .founding .btn { justify-self: end; }
    .proof { grid-template-columns: repeat(4, 1fr); padding: 2rem 2.4rem; }
    .features { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2, 1fr); overflow: visible; margin: 0; padding: 0; }
    .course-row { grid-auto-columns: 44%; padding: 0 24px 1rem; }
  }
  @media (min-width: 1100px) {
    .plans { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 961px) {
    .lc-intro-grid { grid-template-columns: 1fr 1.1fr; gap: 4rem; }
    .lc-phone-only { display: none; }
    .features { grid-template-columns: repeat(4, 1fr); }
    .preview-head, .split { grid-template-columns: 1fr 1.2fr; gap: 4rem; align-items: end; }
    .split { align-items: start; }
    .course-row { max-width: calc(var(--wrap) + 48px); margin: 0 auto; grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); grid-auto-columns: auto; overflow: visible; gap: 1.25rem; }
  }
</style>
