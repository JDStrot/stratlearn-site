---
import { SITE } from '../site';
interface Props { topics: string[]; defaultTopic?: string; needs?: string[]; messageLabel?: string; messagePlaceholder?: string }
const { topics, defaultTopic = topics[0], needs = [], messageLabel = 'Message', messagePlaceholder = '' } = Astro.props;
---
<form class="form" method="post" action="/api/contact" novalidate data-contact-form>
  <label>Name<input name="name" autocomplete="name" required /></label>
  <label>Email<input name="email" type="email" autocomplete="email" required /></label>
  <label><span>Company <span class="opt">(optional)</span></span><input name="company" autocomplete="organization" /></label>
  <label>I'm interested in
    <select name="topic">
      {topics.map((t) => <option selected={t === defaultTopic}>{t}</option>)}
    </select>
  </label>
  {needs.length > 0 && (
    <fieldset class="needs">
      <legend>I'll need <span class="opt">(optional)</span></legend>
      {needs.map((n) => <label class="check"><input type="checkbox" name="needs" value={n} /> {n}</label>)}
    </fieldset>
  )}
  <label>{messageLabel}<textarea name="message" rows="5" required placeholder={messagePlaceholder}></textarea></label>
  <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
  {SITE.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey}></div>}
  <button class="btn btn-primary" type="submit">Send message</button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

{SITE.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script define:vars={{ email: SITE.email }}>
  const wanted = new URLSearchParams(location.search).get('topic');
  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    if (wanted) { const opt = [...form.topic.options].find((o) => o.value === wanted); if (opt) opt.selected = true; }
    const status = form.querySelector('.form-status');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true; status.className = 'form-status'; status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error();
        form.reset();
        status.className = 'form-status ok';
        status.textContent = "Thanks! We'll be in touch within one business day.";
      } catch {
        // Fail safe: always give people a way to reach us.
        status.className = 'form-status err';
        status.innerHTML = `Sorry, that didn't send. Please email <a href="mailto:${email}">${email}</a>.`;
      } finally {
        btn.disabled = false;
        if (window.turnstile) window.turnstile.reset();
      }
    });
  });
</script>

<style>
  .form { background: #fff; color: var(--ink); border-radius: 20px; padding: 2rem; display: grid; gap: 1rem; box-shadow: 0 30px 60px -35px rgba(0,0,0,.5); }
  .form label { display: grid; gap: .35rem; font-family: var(--caps); font-weight: 600; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--plum); }
  .opt { font-weight: 500; color: var(--muted); letter-spacing: .05em; text-transform: none; }
  .form input, .form textarea, .form select { font: inherit; font-family: var(--sans); font-size: 1rem; text-transform: none; letter-spacing: 0; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--ink); }
  .form input:focus, .form textarea:focus, .form select:focus { outline: 2px solid var(--lilac); border-color: var(--violet); }
  .form .btn { justify-self: start; }
  .form .btn[disabled] { opacity: .6; cursor: wait; }
  .needs { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; }
  .needs legend { font-family: var(--caps); font-weight: 600; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--plum); margin-bottom: .5rem; padding: 0; }
  .form .check { display: flex; align-items: center; gap: .5rem; font-family: var(--sans); font-size: 1rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--ink); cursor: pointer; }
  .form .check input { width: 1.1rem; height: 1.1rem; accent-color: var(--violet); padding: 0; }
  .hp { position: absolute !important; left: -9999px; }
  .form-status { margin: 0; font-size: .95rem; min-height: 1.4em; }
  .form-status.ok { color: #1d7a46; }
  .form-status.err { color: #b3261e; }
  .form-status a { color: var(--violet); }
  @media (max-width: 640px) { .form { padding: 1.4rem; } }
</style>
